{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": false },
  "files": { "includes": ["**", "!**/node_modules", "!**/dist", "!**/data", "!public/audio", "!tools/manifest.json", "!package-lock.json"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useButtonType": "off", "useKeyWithClickEvents": "off", "noStaticElementInteractions": "off", "useAriaPropsSupportedByRole": "off", "noSvgWithoutTitle": "off" },
      "correctness": { "useExhaustiveDependencies": "off" },
      "suspicious": { "noAssignInExpressions": "off", "useIterableCallbackReturn": "off", "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "off", "useTemplate": "off", "noParameterAssign": "off", "noDescendingSpecificity": "off" },
      "complexity": { "useOptionalChain": "off", "noImportantStyles": "off" }
    }
  }
}
